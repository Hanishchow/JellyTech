# Copy to .env and fill in. Ask Hanish for the key, or read it with:
#   npx @insforge/cli secrets get ANON_KEY
#
# The anon key is PUBLISHABLE. It ships inside the JavaScript bundle and is
# meant to. Member data is protected by row-level security in Postgres, not by
# hiding this. See insforge/migrations/.
#
# The ADMIN key is a different thing entirely. It lives in
# .insforge/project.json, it is gitignored, and it must never appear here.

VITE_INSFORGE_URL=https://6v9g2tra.ap-southeast.insforge.app
VITE_INSFORGE_ANON_KEY=
